{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Database": {
    "Enabled": false,
    "CommandTimeoutSeconds": 30
  },
  "Services": {
    "Python": {
      "Enabled": false,
      "BaseUrl": "",
      "TimeoutSeconds": 10
    },
    "Rag": {
      "Enabled": false,
      "BaseUrl": "",
      "TimeoutSeconds": 5
    }
  }
}
